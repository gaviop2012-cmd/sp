{
  "name": "spotdl-studio",
  "version": "1.1.0",
  "description": "A local desktop workflow for archiving media from supported links with an app-managed SpotDL environment.",
  "main": "main.js",
  "author": "SpotDL Studio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check scripts/pack-mac.js && node --check scripts/pack-win.js",
    "pack:mac": "node scripts/pack-mac.js",
    "pack:win": "node scripts/pack-win.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "javascript-obfuscator": "^4.1.1"
  },
  "build": {
    "appId": "com.spotdlstudio.app",
    "productName": "SpotDL Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "README.md",
      "LICENSE-PROPRIETARY.txt",
      "licenses/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "identity": null,
      "target": [
        "zip",
        "dmg"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SpotDL-Studio-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpotDL Studio"
    }
  }
}
